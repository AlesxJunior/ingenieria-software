# Variables de entorno para producción
# Cambia esto a tu backend cuando lo despliegues
VITE_API_URL=http://localhost:3001/api

# Si quieres acceder desde tu red local mientras desarrollas:
# VITE_API_URL=http://TU-IP-LOCAL:3001/api
# Ejemplo: VITE_API_URL=http://192.168.1.100:3001/api

# Cuando despliegues el backend:
# VITE_API_URL=https://tu-backend.onrender.com/api
