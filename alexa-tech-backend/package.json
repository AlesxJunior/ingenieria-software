{
  "name": "alexa-tech-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed-roles": "ts-node --compiler-options {\\\"lib\\\":[\\\"ES2020\\\",\\\"dom\\\"],\\\"types\\\":[\\\"node\\\"]} prisma/seed-roles.ts",
    "db:seed-ubigeo": "ts-node --compiler-options {\\\"lib\\\":[\\\"ES2020\\\",\\\"dom\\\"],\\\"types\\\":[\\\"node\\\"]} prisma/seed-ubigeo-complete.ts",
    "db:seed-departamentos": "ts-node --compiler-options {\\\"lib\\\":[\\\"ES2020\\\",\\\"dom\\\"],\\\"types\\\":[\\\"node\\\"]} prisma/seed-departamentos-peru.ts",
    "db:fix-departamentos": "ts-node --compiler-options {\\\"lib\\\":[\\\"ES2020\\\",\\\"dom\\\"],\\\"types\\\":[\\\"node\\\"]} prisma/fix-departamentos-duplicados.ts",
    "db:seed-ubigeo-principales": "ts-node --compiler-options {\\\"lib\\\":[\\\"ES2020\\\",\\\"dom\\\"],\\\"types\\\":[\\\"node\\\"]} prisma/seed-ubigeo-principales.ts",
    "db:fix-ubigeo-duplicados": "ts-node --compiler-options {\\\"lib\\\":[\\\"ES2020\\\",\\\"dom\\\"],\\\"types\\\":[\\\"node\\\"]} prisma/fix-ubigeo-duplicados.ts",
    "db:seed-provincias-completas": "ts-node --compiler-options {\\\"lib\\\":[\\\"ES2020\\\",\\\"dom\\\"],\\\"types\\\":[\\\"node\\\"]} prisma/seed-provincias-completas.ts",
    "db:seed-distritos-completos": "ts-node --compiler-options {\\\"lib\\\":[\\\"ES2020\\\",\\\"dom\\\"],\\\"types\\\":[\\\"node\\\"]} prisma/seed-distritos-completos.ts",
    "db:seed-san-martin-completo": "ts-node --compiler-options {\\\"lib\\\":[\\\"ES2020\\\",\\\"dom\\\"],\\\"types\\\":[\\\"node\\\"]} prisma/seed-san-martin-completo.ts",
    "db:verificar-san-martin": "ts-node --compiler-options {\\\"lib\\\":[\\\"ES2020\\\",\\\"dom\\\"],\\\"types\\\":[\\\"node\\\"]} prisma/verificar-san-martin.ts",
    "test:rbac": "node scripts/test-rbac-system.js",
    "test:clients": "node scripts/test-clients-module.js",
    "test:users": "npx prisma migrate reset --force && node scripts/test-users-module.js",
    "test:productos": "node scripts/test-products-module.js",
    "test:all": "node scripts/run-all-tests.js",
    "check:auth": "node scripts/check-auth-health.js",
    "check:auth:admin": "set AUTH_EMAIL=admin@alexatech.com&& set AUTH_PASSWORD=admin123&& node scripts/check-auth-health.js",
    "check:auth:supervisor": "set AUTH_EMAIL=supervisor@alexatech.com&& set AUTH_PASSWORD=supervisor123&& node scripts/check-auth-health.js",
    "test:entidades:admin": "set AUTH_EMAIL=admin@alexatech.com&& set AUTH_PASSWORD=admin123&& node scripts/test-clients-module.js"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [
    "alexa-tech",
    "backend",
    "api",
    "typescript"
  ],
  "author": "Alexa Tech Team",
  "license": "MIT",
  "description": "Backend API para el sistema de gestión empresarial Alexa Tech",
  "dependencies": {
    "@alexa-tech/shared": "file:../shared",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@prisma/client": "^6.16.2",
    "@types/pdfkit": "^0.17.4",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "node-fetch": "^2.7.0",
    "pdfkit": "^0.17.2",
    "prisma": "^6.16.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitest/coverage-v8": "^4.0.6",
    "@vitest/ui": "^4.0.6",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.1",
    "vitest": "^4.0.6"
  }
}
