generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum para el tipo de entidad comercial
enum TipoEntidad {
  Cliente
  Proveedor
  Ambos
}

// ============================================
// MÓDULO DE CONFIGURACIÓN - MAESTROS DE PRODUCTOS
// ============================================

model ProductCategory {
  id          String  @id @default(cuid())
  codigo      String  @unique // Código corto único (ej: "ABR", "BEB", "LAC")
  nombre      String  @unique // Nombre de la categoría (ej: "Abarrotes", "Bebidas")
  descripcion String? // Descripción opcional de la categoría
  activo      Boolean @default(true) // Permite soft delete de categorías

  // Auditoría
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con productos
  products Product[] @relation("ProductCategoryRelation")

  @@map("product_categories")
}

model UnitOfMeasure {
  id          String  @id @default(cuid())
  codigo      String  @unique // Código corto único (ej: "UND", "KG", "LT")
  nombre      String  @unique // Nombre de la unidad (ej: "Unidad", "Kilogramo", "Litro")
  simbolo     String? // Símbolo opcional (ej: "kg", "lt", "un")
  descripcion String? // Descripción opcional
  activo      Boolean @default(true) // Permite soft delete de unidades

  // Auditoría
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con productos
  products Product[] @relation("ProductUnitRelation")

  @@map("units_of_measure")
}

// ============================================
// MÓDULO DE ROLES Y PERMISOS (RBAC)
// ============================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // Nombre único del rol (ej: "Admin", "Vendedor")
  description String? // Descripción del propósito del rol
  permissions String[] @default([]) // Array de permisos asignados al rol
  isActive    Boolean  @default(true) // Permite desactivar roles sin eliminarlos
  isSystem    Boolean  @default(false) // Roles del sistema no se pueden eliminar (Admin, Supervisor, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  users User[]

  @@map("roles")
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  username   String    @unique
  password   String
  firstName  String
  lastName   String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastAccess DateTime?

  // RBAC: Relación con Role (OBLIGATORIO)
  roleId String // ID del rol asignado (obligatorio para RBAC puro)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // Relaciones
  auditLogs          AuditLog[]
  userActivities     UserActivity[]
  productsCreated    Product[]           @relation("ProductCreatedBy")
  productsUpdated    Product[]           @relation("ProductUpdatedBy")
  clientsCreated     Client[]            @relation("ClientCreatedBy")
  clientsUpdated     Client[]            @relation("ClientUpdatedBy")
  purchaseOrders     Purchase[]          @relation("PurchaseCreatedBy")
  inventoryMovements InventoryMovement[]
  cashSessions       CashSession[]       @relation("CashSessionUser")
  cashMovements      CashMovement[]      @relation("CashMovementUser")
  sales              Sale[]              @relation("SaleCreatedBy")
  quotes             Quote[]             @relation("QuoteCreatedBy")
  
  // Relaciones - Módulo de Compras
  solicitudesCreadas      PurchaseRequest[]  @relation("SolicitudPor")
  solicitudesAprobadas    PurchaseRequest[]  @relation("AprobadoPor")
  ordenesCompraCreadas    PurchaseOrder[]    @relation("OCCreadoPor")
  ordenesCompraAprobadas  PurchaseOrder[]    @relation("OCAprobadoPor")
  recepcionesRecibidas    PurchaseReceipt[]  @relation("RCRecibidoPor")
  recepcionesInspeccionadas PurchaseReceipt[] @relation("RCInspeccionadoPor")
  facturasRegistradas     PurchaseInvoice[]  @relation("FacturaRegistradaPor")
  
  // Relaciones - Módulo de Inventario (Transferencias)
  transfersSolicitados StockTransfer[] @relation("TransferSolicitante")
  transfersAprobados   StockTransfer[] @relation("TransferAprobador")
  transfersRecibidos   StockTransfer[] @relation("TransferReceptor")

  @@map("users")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String // LOGIN, CREATE_USER, UPDATE_USER, DELETE_USER, etc.
  userId    String? // Usuario que realizó la acción
  targetId  String? // ID del recurso afectado
  details   String? // Detalles adicionales de la acción
  ipAddress String? // Dirección IP del usuario
  userAgent String? // User agent del navegador
  createdAt DateTime @default(now())

  // Relación con usuario
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String // Usuario que realizó la actividad
  action    String // Tipo de actividad
  details   String? // Detalles de la actividad
  ipAddress String? // Dirección IP
  userAgent String? // User agent del navegador
  createdAt DateTime @default(now())

  // Relación con usuario
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_activities")
}

model SystemEvent {
  id        String   @id @default(cuid())
  type      String // SYSTEM_START, DATABASE_BACKUP, ERROR, etc.
  details   String? // Detalles del evento
  metadata  Json? // Metadatos adicionales en formato JSON
  createdAt DateTime @default(now())

  @@map("system_events")
}

model Departamento {
  id         String      @id
  nombre     String
  provincias Provincia[]
  clients    Client[]

  @@map("departments")
}

model Provincia {
  id             String       @id
  nombre         String
  departamentoId String
  departamento   Departamento @relation(fields: [departamentoId], references: [id])
  distritos      Distrito[]
  clients        Client[]

  @@map("provinces")
}

model Distrito {
  id          String    @id
  nombre      String
  provinciaId String
  provincia   Provincia @relation(fields: [provinciaId], references: [id])
  clients     Client[]

  @@map("districts")
}

model Client {
  id              String      @id @default(cuid())
  // Tipo de entidad comercial (Cliente, Proveedor o Ambos)
  tipoEntidad     TipoEntidad @default(Cliente)
  tipoDocumento   String // DNI, RUC, CE, Pasaporte
  numeroDocumento String      @unique // Número de documento único

  // Campos para DNI y CE (Personas Naturales)
  nombres   String? // Nombres (solo para DNI/CE/Pasaporte)
  apellidos String? // Apellidos (solo para DNI/CE/Pasaporte)

  // Campos para RUC (Personas Jurídicas)
  razonSocial String? // Razón Social (solo para RUC)

  // Campos comunes
  email     String @unique // Email único del cliente
  telefono  String // Teléfono de contacto
  direccion String // Dirección

  // Ubicación (Perú)
  departamentoId String
  provinciaId    String
  distritoId     String
  departamento   Departamento @relation(fields: [departamentoId], references: [id])
  provincia      Provincia    @relation(fields: [provinciaId], references: [id])
  distrito       Distrito     @relation(fields: [distritoId], references: [id])

  // Auditoría de creación/actualización
  usuarioCreacion      String?
  usuarioActualizacion String?
  createdBy            User?   @relation("ClientCreatedBy", fields: [usuarioCreacion], references: [id], onDelete: SetNull)
  updatedBy            User?   @relation("ClientUpdatedBy", fields: [usuarioActualizacion], references: [id], onDelete: SetNull)

  isActive  Boolean  @default(true) // Soft delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones inversas
  sales  Sale[]  @relation("SaleClient")
  quotes Quote[] @relation("QuoteClient")
  
  // Relaciones - Módulo de Compras (Proveedores)
  ordenesCompra    PurchaseOrder[]    @relation("OCProveedor")
  facturasCompra   PurchaseInvoice[]  @relation("FacturaProveedor")
  cuentasPorPagar  AccountPayable[]   @relation("CuentaPorPagarProveedor")

  @@map("commercial_entities")
}

model Product {
  id          String  @id @default(cuid())
  codigo      String  @unique
  nombre      String
  descripcion String?

  // ============================================
  // CATEGORÍA Y UNIDAD DE MEDIDA - RELACIONES FK
  // ============================================
  // Temporalmente opcionales para permitir migración de datos
  categoriaId String?
  categoria   ProductCategory? @relation("ProductCategoryRelation", fields: [categoriaId], references: [id], onDelete: Restrict)

  unidadMedidaId String?
  unidadMedida   UnitOfMeasure? @relation("ProductUnitRelation", fields: [unidadMedidaId], references: [id], onDelete: Restrict)

  // ============================================
  // CAMPOS LEGACY (DEPRECADOS - Mantener para migración)
  // ============================================
  /// @deprecated: Campo legacy. Mantener temporalmente para compatibilidad.
  /// TODO: Eliminar este campo y migrar datos cuando la transición complete.
  categoria_legacy    String? @map("categoria") // DEPRECATED

  /// @deprecated: Campo legacy. Mantener temporalmente para compatibilidad.
  /// TODO: Eliminar este campo y migrar datos cuando la transición complete.
  unidadMedida_legacy String? @map("unidadMedida") // DEPRECATED

  precioVenta Decimal
  stock       Int     @default(0)
  minStock    Int?

  // NOTA: trackInventory reservado para futuras features
  // Propósito: Habilitar/deshabilitar rastreo de inventario por producto
  // Estado actual: Campo presente en BD pero NO implementado en frontend/backend
  // Acción: Mantener para compatibilidad futura
  trackInventory Boolean @default(true)

  estado Boolean @default(true) // Activo/Inactivo (soft delete)

  // Auditoría de creación/actualización
  usuarioCreacion      String?
  usuarioActualizacion String?
  createdBy            User?   @relation("ProductCreatedBy", fields: [usuarioCreacion], references: [id], onDelete: SetNull)
  updatedBy            User?   @relation("ProductUpdatedBy", fields: [usuarioActualizacion], references: [id], onDelete: SetNull)

  // Relación con items de compra
  purchaseItems PurchaseItem[] @relation("PurchaseItemProduct")

  // Relación con items de venta
  saleItems SaleItem[] @relation("SaleItemProduct")

  // Relación con items de cotización
  quoteItems QuoteItem[]

  // Relaciones de inventario
  stockByWarehouses  StockByWarehouse[]
  inventoryMovements InventoryMovement[]
  stockTransfers     StockTransfer[]
  
  // Relaciones - Módulo de Compras
  solicitudItems      PurchaseRequestItem[] @relation("SolicitudProducto")
  ordenCompraItems    PurchaseOrderItem[]   @relation("OCProducto")
  recepcionItems      PurchaseReceiptItem[] @relation("RecepcionProducto")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

// Enum para estado de compra
enum PurchaseStatus {
  Pendiente
  Recibida
  Cancelada
}

// Enum para tipo de comprobante
enum VoucherType {
  Factura
  Boleta
  GuiaRemision
}

// Enum para forma de pago
enum PaymentMethod {
  Efectivo
  Tarjeta
  Transferencia
}

// Enums para Ventas
enum SaleType {
  Venta
  NotaCredito
}

enum SaleStatus {
  Pendiente // Venta registrada, esperando confirmación de pago
  Completada // Pago verificado y completado (puede tener NC después)
  Cancelada // Cliente no concretó la venta (timeout o cancelación manual)
}

// ✅ SIMPLIFICADO A 2 MOTIVOS: NC = Devolución física de productos
// Otros casos (errores de datos/precios) se manejan con edición directa o anulación
enum CreditNoteReason {
  DevolucionTotal // Cliente devuelve TODOS los productos físicamente
  DevolucionParcial // Cliente devuelve ALGUNOS productos físicamente
}

// ✅ NUEVO: Estados de las Notas de Crédito
enum CreditNoteStatus {
  Pendiente // Vale no usado (crédito a favor del cliente)
  Reembolsada // Ya se devolvió el dinero
  PendientePagoBancario // Esperando transferencia bancaria
  Aplicada // Usada en otra venta (FUTURO)
  Cancelada // Anulada
}

// ✅ NUEVO: Métodos de procesamiento de NC
enum CreditNotePaymentMethod {
  Efectivo // Reembolso en efectivo
  Transferencia // Transferencia bancaria
  Vale // Crédito a favor (pendiente de aplicar)
}

enum SalePaymentMethod {
  Efectivo
  Tarjeta
  Transferencia
  Yape
  Plin
}

enum SaleVoucherType {
  Boleta
  Factura
  NotaVenta
}

enum CashRegisterStatus {
  Abierta
  Cerrada
}

// Enums para Movimientos de Caja
enum CashMovementType {
  INGRESO
  EGRESO
}

// Enums para Cotizaciones
enum QuoteStatus {
  Pendiente
  Aceptada
  Convertida
  Rechazada
  Vencida
  Cancelada
}

model Purchase {
  id                   String         @id @default(cuid())
  codigoOrden          String         @unique
  proveedorId          String
  almacenId            String
  fechaEmision         DateTime
  fechaEntregaEstimada DateTime?
  tipoComprobante      VoucherType?
  formaPago            PaymentMethod?
  subtotal             Decimal        @default(0)
  descuento            Decimal        @default(0)
  total                Decimal        @default(0)
  estado               PurchaseStatus @default(Pendiente)
  observaciones        String?

  usuarioId String?
  usuario   User?   @relation("PurchaseCreatedBy", fields: [usuarioId], references: [id], onDelete: SetNull)

  items PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("purchase_orders")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productCodigo String
  product       Product @relation("PurchaseItemProduct", fields: [productCodigo], references: [codigo], onDelete: SetNull)

  nombreProducto String?
  cantidad       Int
  precioUnitario Decimal
  subtotal       Decimal

  @@map("purchase_items")
}

// Inventario: enums
enum MovementType {
  ENTRADA
  SALIDA
  AJUSTE
}

enum AdjustmentDirection {
  INCREMENT
  DECREMENT
}

enum AdjustmentReason {
  MermaDanio
  MermaRotura
  DevolucionCliente
  ErrorConteo
  OtroRazon
}

model MovementReason {
  id                String       @id @default(cuid())
  tipo              MovementType @map("type")
  codigo            String       @unique
  nombre            String
  descripcion       String?
  activo            Boolean      @default(true)
  requiereDocumento Boolean      @default(false) @map("requiresDocument")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  inventoryMovements InventoryMovement[]

  @@map("movement_reasons")
}

// ============================================
// ENUMS PARA TRANSFERENCIAS
// ============================================

enum TransferStatus {
  PENDIENTE   // Creada, esperando aprobación
  APROBADO    // Aprobada, lista para enviar
  ENVIADO     // En tránsito
  RECIBIDO    // Completada
  CANCELADO   // Cancelada
}

// ============================================
// MÓDULO DE INVENTARIO
// ============================================

model Warehouse {
  id        String   @id @default(cuid())
  codigo    String   @unique
  nombre    String
  ubicacion String?
  capacidad Int?
  activo    Boolean  @default(true) @map("isActive")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones de inventario
  stockByWarehouses  StockByWarehouse[]
  inventoryMovements InventoryMovement[]
  transfersFrom      StockTransfer[]     @relation("TransferFrom")
  transfersTo        StockTransfer[]     @relation("TransferTo")
  
  // Relaciones - Módulo de Compras
  solicitudesCompra PurchaseRequest[] @relation("SolicitudAlmacenDestino")
  ordenesCompra     PurchaseOrder[]   @relation("OCAlmacenDestino")
  recepciones       PurchaseReceipt[] @relation("RecepcionAlmacen")

  @@map("warehouses")
}

model StockByWarehouse {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Int      @default(0) @map("cantidad")
  minStock    Int?     @map("stockMinimo") /// @deprecated Usar Product.minStock en su lugar
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@map("stock_by_warehouse")
}

model InventoryMovement {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  type        String   @map("tipo")
  quantity    Int      @map("cantidad")
  stockBefore Int      @map("stockAntes")
  stockAfter  Int      @map("stockDespues")
  reason      String   @map("motivo") // Mantenemos compatibilidad con datos existentes
  reasonId    String?  @map("reasonId") // Nueva relación opcional
  documentRef String?  @map("documentoReferencia")
  userId      String?  @map("usuarioId")
  createdAt   DateTime @default(now())

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  movementReason MovementReason? @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  
  // Relación con recepción de compra (opcional)
  recepcionCompra   PurchaseReceipt? @relation("RecepcionMovimientos", fields: [recepcionCompraId], references: [id], onDelete: SetNull)
  recepcionCompraId String?
  
  // Relación con transferencias
  transferSalida  StockTransfer? @relation("TransferSalida")
  transferEntrada StockTransfer? @relation("TransferEntrada")

  @@map("inventory_movements")
}

model StockTransfer {
  id                  String         @id @default(cuid())
  codigo              String         @unique // TRF-2025-001
  
  // Producto y cantidad
  productId           String
  product             Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  cantidad            Int
  
  // Almacenes origen y destino
  warehouseFromId     String
  warehouseFrom       Warehouse      @relation("TransferFrom", fields: [warehouseFromId], references: [id], onDelete: Restrict)
  
  warehouseToId       String
  warehouseTo         Warehouse      @relation("TransferTo", fields: [warehouseToId], references: [id], onDelete: Restrict)
  
  // Estado y observaciones
  estado              TransferStatus @default(PENDIENTE)
  observaciones       String?
  motivoTransferencia String?
  
  // Workflow: Solicitante
  solicitadoPor       String
  solicitante         User           @relation("TransferSolicitante", fields: [solicitadoPor], references: [id], onDelete: Restrict)
  
  // Workflow: Aprobador (opcional)
  aprobadoPor         String?
  aprobador           User?          @relation("TransferAprobador", fields: [aprobadoPor], references: [id], onDelete: SetNull)
  fechaAprobacion     DateTime?
  
  // Workflow: Receptor (opcional)
  recibidoPor         String?
  receptor            User?          @relation("TransferReceptor", fields: [recibidoPor], references: [id], onDelete: SetNull)
  fechaRecepcion      DateTime?
  
  // Referencias a movimientos de inventario
  movimientoSalidaId  String?        @unique
  movimientoSalida    InventoryMovement? @relation("TransferSalida", fields: [movimientoSalidaId], references: [id], onDelete: SetNull)
  
  movimientoEntradaId String?        @unique
  movimientoEntrada   InventoryMovement? @relation("TransferEntrada", fields: [movimientoEntradaId], references: [id], onDelete: SetNull)
  
  // Timestamps
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  
  @@map("stock_transfers")
}

// ============================================
// MÓDULO DE VENTAS
// ============================================

model CashRegister {
  id        String   @id @default(cuid())
  codigo    String   @unique
  nombre    String
  ubicacion String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  cashSessions CashSession[]

  @@map("cash_registers")
}

model CashSession {
  id             String             @id @default(cuid())
  cashRegisterId String
  userId         String
  fechaApertura  DateTime           @default(now())
  fechaCierre    DateTime?
  montoApertura  Decimal            @default(0)
  montoCierre    Decimal?
  totalVentas    Decimal            @default(0)
  diferencia     Decimal?
  estado         CashRegisterStatus @default(Abierta)
  observaciones  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Relaciones
  cashRegister CashRegister   @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  user         User           @relation("CashSessionUser", fields: [userId], references: [id], onDelete: Cascade)
  sales        Sale[]
  movements    CashMovement[]

  @@map("cash_sessions")
}

model Sale {
  id              String             @id @default(cuid())
  codigoVenta     String             @unique
  tipo            SaleType           @default(Venta)
  cashSessionId   String?
  clienteId       String?
  almacenId       String
  usuarioId       String
  fechaEmision    DateTime           @default(now())
  tipoComprobante SaleVoucherType    @default(Boleta)
  formaPago       SalePaymentMethod? // ⚠️ DEPRECATED: Usar payments[] en su lugar
  subtotal        Decimal            @default(0)
  igv             Decimal            @default(0)
  total           Decimal            @default(0)
  estado          SaleStatus         @default(Pendiente)
  observaciones   String?

  // Campos para tracking de pago
  montoRecibido  Decimal   @default(0)
  montoCambio    Decimal   @default(0)
  referenciaPago String? // Número de operación/voucher/código QR
  fechaPago      DateTime? // Fecha de confirmación del pago

  // Campos para Notas de Crédito
  saleOriginId          String?
  creditNoteReason      CreditNoteReason?
  creditNoteDescription String?

  // ✅ NUEVOS: Estado y método de procesamiento de NC
  creditNoteStatus        CreditNoteStatus?
  creditNotePaymentMethod CreditNotePaymentMethod?
  creditNoteRefundDate    DateTime?
  cashMovementId          String?

  // Campo para rastrear origen de cotización
  quoteOriginId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  cashSession CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  cliente     Client?       @relation("SaleClient", fields: [clienteId], references: [id], onDelete: SetNull)
  usuario     User          @relation("SaleCreatedBy", fields: [usuarioId], references: [id], onDelete: Cascade)
  items       SaleItem[]
  payments    SalePayment[] @relation("SalePayments") // 🆕 NUEVO: Relación con pagos múltiples

  // Relación para Notas de Crédito
  saleOrigin  Sale?  @relation("CreditNotes", fields: [saleOriginId], references: [id], onDelete: Restrict)
  creditNotes Sale[] @relation("CreditNotes")

  // ✅ NUEVO: Relación con movimiento de caja (si NC es reembolsada en efectivo)
  cashMovement CashMovement? @relation("CreditNoteCashMovement", fields: [cashMovementId], references: [id], onDelete: SetNull)

  // Relación con cotización
  quoteOrigin Quote? @relation("QuoteConvertedToSale", fields: [quoteOriginId], references: [id], onDelete: SetNull)

  @@map("sales")
}

model SaleItem {
  id             String   @id @default(cuid())
  saleId         String
  productId      String
  nombreProducto String
  cantidad       Int
  precioUnitario Decimal
  subtotal       Decimal
  createdAt      DateTime @default(now())

  // Relaciones
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation("SaleItemProduct", fields: [productId], references: [id], onDelete: Cascade)

  @@map("sale_items")
}

// 🆕 NUEVO: Modelo para Pagos Múltiples en Ventas
model SalePayment {
  id            String            @id @default(cuid())
  saleId        String
  metodoPago    SalePaymentMethod
  monto         Decimal
  referencia    String? // Número de operación, voucher, código QR, etc.
  observaciones String?
  orden         Int               @default(1) // Orden del pago (1 = primero, 2 = segundo)
  createdAt     DateTime          @default(now())

  // Relaciones
  sale Sale @relation("SalePayments", fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_payments")
}

// Modelo para Movimientos de Caja
model CashMovement {
  id            String           @id @default(cuid())
  cashSessionId String
  tipo          CashMovementType
  monto         Decimal
  motivo        String
  descripcion   String?
  usuarioId     String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relaciones
  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  usuario     User        @relation("CashMovementUser", fields: [usuarioId], references: [id], onDelete: Cascade)

  // ✅ NUEVO: Relación inversa con NC que tienen reembolso
  creditNote Sale[] @relation("CreditNoteCashMovement")

  @@map("cash_movements")
}

// Modelo para Cotizaciones
model Quote {
  id                 String      @id @default(cuid())
  codigoCotizacion   String      @unique
  clienteId          String?
  almacenId          String
  usuarioId          String
  fechaEmision       DateTime    @default(now())
  fechaVencimiento   DateTime
  diasValidez        Int         @default(15)
  subtotal           Decimal     @default(0)
  igv                Decimal     @default(0)
  total              Decimal     @default(0)
  estado             QuoteStatus @default(Pendiente)
  observaciones      String?
  motivoRechazo      String?
  intentosConversion Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Relaciones
  cliente        Client?     @relation("QuoteClient", fields: [clienteId], references: [id], onDelete: SetNull)
  usuario        User        @relation("QuoteCreatedBy", fields: [usuarioId], references: [id], onDelete: Cascade)
  items          QuoteItem[]
  salesConverted Sale[]      @relation("QuoteConvertedToSale")

  @@index([estado])
  @@index([fechaEmision])
  @@index([clienteId])
  @@map("quotes")
}

model QuoteItem {
  id             String   @id @default(cuid())
  quoteId        String
  productId      String
  nombreProducto String
  cantidad       Int
  precioUnitario Decimal
  subtotal       Decimal
  createdAt      DateTime @default(now())

  // Relaciones
  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("quote_items")
}

// Modelo para Configuración de la Empresa
model Company {
  id              String   @id @default(cuid())
  ruc             String   @unique
  razonSocial     String
  nombreComercial String
  direccion       String
  telefono        String
  email           String
  website         String?
  logo            String?
  igvActivo       Boolean  @default(true)
  igvPorcentaje   Decimal  @default(18)
  moneda          String   @default("PEN")
  pais            String   @default("Perú")
  departamento    String   @default("")
  provincia       String   @default("")
  distrito        String   @default("")
  codigoPostal    String?
  sunatUsuario    String?
  sunatClave      String?
  sunatServidor   String   @default("homologacion") // produccion o homologacion
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("company")
}

// Modelo para Tipos de Comprobantes
model ComprobanteType {
  id             String   @id @default(cuid())
  codigo         String   @unique
  nombre         String
  descripcion    String?
  tipo           String // factura, boleta, nota-credito, nota-debito
  serie          String
  numeroActual   Int      @default(1)
  numeroInicio   Int      @default(1)
  numeroFin      Int      @default(99999)
  activo         Boolean  @default(true)
  predeterminado Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("comprobante_types")
}

// Modelo para Métodos de Pago (Configuración)
model PaymentMethodConfig {
  id                 String   @id @default(cuid())
  codigo             String   @unique
  nombre             String
  descripcion        String?
  tipo               String // Efectivo, Tarjeta, Transferencia, etc.
  activo             Boolean  @default(true)
  predeterminado     Boolean  @default(false)
  requiereReferencia Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("payment_method_config")
}

// ============================================
// MÓDULO DE COMPRAS PROFESIONAL
// ============================================

// Enums para Solicitudes de Compra
enum PurchaseRequestStatus {
  BORRADOR   // En creación
  APROBADA   // Aprobada, lista para OC
  RECHAZADA  // Rechazada
  CONVERTIDA // Convertida a OC
  CANCELADA  // Cancelada
}

enum PurchaseRequestPriority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

// Enums para Órdenes de Compra
enum PurchaseOrderStatus {
  PENDIENTE     // Creada, no enviada
  ENVIADA       // Enviada al proveedor
  CONFIRMADA    // Proveedor confirmó
  EN_RECEPCION  // Llegó mercancía, en proceso de recepción
  PARCIAL       // Recepción parcial
  COMPLETADA    // Todo recibido (estado final)
  CANCELADA     // Cancelada
}

// Enums para Recepciones de Compra
enum PurchaseReceiptStatus {
  PENDIENTE   // En creación
  INSPECCION  // En control de calidad
  CONFIRMADA  // Confirmada, stock actualizado
  CANCELADA   // Cancelada
}

// Enums para Control de Calidad
enum QualityControlStatus {
  PENDIENTE  // Aún no inspeccionado
  APROBADO   // Aprobado
  RECHAZADO  // Rechazado
  PARCIAL    // Parcialmente aprobado
}

// Enums para Cuentas por Pagar
enum AccountPayableStatus {
  PENDIENTE // Sin pagar
  PARCIAL   // Pago parcial
  PAGADA    // Pagada completamente
  VENCIDA   // Pasó fecha de vencimiento
  ANULADA   // Anulada
}

// ============================================
// MODELOS DEL MÓDULO DE COMPRAS
// ============================================

// Solicitud de Compra (Purchase Request)
model PurchaseRequest {
  id          String                   @id @default(cuid())
  codigo      String                   @unique // SR-2025-0001
  estado      PurchaseRequestStatus    @default(BORRADOR)
  
  // Relaciones con usuarios
  solicitadoPorId String
  solicitadoPor   User   @relation("SolicitudPor", fields: [solicitadoPorId], references: [id], onDelete: Restrict)
  
  aprobadoPorId   String?
  aprobadoPor     User?   @relation("AprobadoPor", fields: [aprobadoPorId], references: [id], onDelete: SetNull)
  
  // Relación con almacén destino
  almacenDestinoId String
  almacenDestino   Warehouse @relation("SolicitudAlmacenDestino", fields: [almacenDestinoId], references: [id], onDelete: Restrict)
  
  // Datos de la solicitud
  fechaSolicitud  DateTime                  @default(now())
  fechaNecesaria  DateTime // Cuándo se necesita
  prioridad       PurchaseRequestPriority   @default(MEDIA)
  motivo          String // Razón de la solicitud
  observaciones   String?
  
  // Aprobación
  fechaAprobacion       DateTime?
  comentariosAprobacion String?
  
  // Items de la solicitud
  items PurchaseRequestItem[]
  
  // Orden de compra generada (opcional)
  ordenCompra PurchaseOrder?
  
  // Auditoría
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete
  
  @@map("purchase_requests")
}

// Items de Solicitud de Compra
model PurchaseRequestItem {
  id String @id @default(cuid())
  
  // Relación con solicitud
  solicitudId String
  solicitud   PurchaseRequest @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  
  // Relación con producto
  productoId String
  producto   Product @relation("SolicitudProducto", fields: [productoId], references: [id], onDelete: Restrict)
  
  // Cantidades
  cantidadSolicitada Int // Cantidad requerida
  stockActual        Int // Stock al momento de solicitar
  stockMinimo        Int // Stock mínimo configurado
  
  observaciones String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("purchase_request_items")
}

// Orden de Compra (Purchase Order)
model PurchaseOrder {
  id     String               @id @default(cuid())
  codigo String               @unique // OC-2025-0001
  estado PurchaseOrderStatus  @default(PENDIENTE)
  
  // Relación con proveedor
  proveedorId String
  proveedor   Client @relation("OCProveedor", fields: [proveedorId], references: [id], onDelete: Restrict)
  
  // Relación con almacén destino
  almacenDestinoId String
  almacenDestino   Warehouse @relation("OCAlmacenDestino", fields: [almacenDestinoId], references: [id], onDelete: Restrict)
  
  // Relaciones con usuarios
  creadoPorId String
  creadoPor   User   @relation("OCCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  
  aprobadoPorId String?
  aprobadoPor   User?  @relation("OCAprobadoPor", fields: [aprobadoPorId], references: [id], onDelete: SetNull)
  
  // Origen (opcional - solicitud de compra)
  solicitudCompraId String?           @unique
  solicitudCompra   PurchaseRequest?  @relation(fields: [solicitudCompraId], references: [id], onDelete: SetNull)
  
  // Fechas
  fechaEmision         DateTime  @default(now())
  fechaEnvio           DateTime? // Cuándo se envió al proveedor
  fechaConfirmacion    DateTime? // Cuándo el proveedor confirmó
  fechaEntregaEstimada DateTime // Cuándo debería llegar
  fechaEntregaReal     DateTime? // Cuándo realmente llegó
  
  // Datos comerciales
  moneda     String  @default("PEN") // PEN, USD
  tipoCambio Decimal @default(1.00) @db.Decimal(10, 4)
  
  condicionesPago   String // "Contado", "Crédito 30 días"
  formaPago         String // "Transferencia", "Efectivo"
  
  observaciones       String?
  terminosCondiciones String? // Términos adicionales
  
  // Referencia proveedor
  numeroOCProveedor String? // Número de OC que asigna el proveedor
  
  // Totales
  subtotal  Decimal @db.Decimal(10, 2)
  descuento Decimal @default(0) @db.Decimal(10, 2)
  igv       Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)
  
  // Items de la orden
  items PurchaseOrderItem[]
  
  // Recepciones asociadas
  recepciones PurchaseReceipt[]
  
  // Factura asociada
  factura PurchaseInvoice?
  
  // Auditoría
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete
  
  @@index([proveedorId])
  @@index([estado])
  @@index([fechaEmision])
  @@map("purchase_orders_v2")
}

// Items de Orden de Compra
model PurchaseOrderItem {
  id String @id @default(cuid())
  
  // Relación con orden de compra
  ordenCompraId String
  ordenCompra   PurchaseOrder @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  
  // Relación con producto
  productoId String
  producto   Product @relation("OCProducto", fields: [productoId], references: [id], onDelete: Restrict)
  
  // Cantidades
  cantidadOrdenada  Int // Cantidad pedida
  cantidadRecibida  Int @default(0) // Cantidad recibida (acumulado)
  cantidadAceptada  Int @default(0) // Cantidad aceptada (QC OK)
  cantidadRechazada Int @default(0) // Cantidad rechazada (QC FAIL)
  cantidadPendiente Int // cantidadOrdenada - cantidadRecibida
  
  // Precios
  precioUnitario Decimal @db.Decimal(10, 2)
  descuento      Decimal @default(0) @db.Decimal(10, 2) // % o monto
  incluyeIGV     Boolean @default(true) // Si el item incluye IGV o no
  subtotal       Decimal @db.Decimal(10, 2)
  igv            Decimal @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)
  
  // Datos adicionales
  descripcion   String? // Descripción específica del item
  observaciones String?
  
  // Relación con items de recepción
  recepcionItems PurchaseReceiptItem[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([ordenCompraId])
  @@index([productoId])
  @@map("purchase_order_items")
}

// Recepción de Compra (Purchase Receipt)
model PurchaseReceipt {
  id     String                 @id @default(cuid())
  codigo String                 @unique // RC-2025-0001
  estado PurchaseReceiptStatus  @default(PENDIENTE)
  
  // Relación con orden de compra
  ordenCompraId String
  ordenCompra   PurchaseOrder @relation(fields: [ordenCompraId], references: [id], onDelete: Restrict)
  
  // Relación con almacén
  almacenId String
  almacen   Warehouse @relation("RecepcionAlmacen", fields: [almacenId], references: [id], onDelete: Restrict)
  
  // Relaciones con usuarios
  recibidoPorId String
  recibidoPor   User   @relation("RCRecibidoPor", fields: [recibidoPorId], references: [id], onDelete: Restrict)
  
  inspeccionadoPorId String?
  inspeccionadoPor   User?  @relation("RCInspeccionadoPor", fields: [inspeccionadoPorId], references: [id], onDelete: SetNull)
  
  // Fechas
  fechaRecepcion  DateTime @default(now())
  horaRecepcion   DateTime @default(now())
  fechaInspeccion DateTime?
  
  // Datos de entrega
  guiaRemision       String? // Guía del proveedor
  transportista      String?
  condicionMercancia String? // "Buena", "Con daños", etc.
  
  // Tipo de recepción
  esRecepcionCompleta Boolean @default(false)
  esRecepcionParcial  Boolean @default(false)
  
  // Observaciones
  observaciones String?
  incidencias   String? // Problemas encontrados
  
  // Items recibidos
  items PurchaseReceiptItem[]
  
  // Movimientos de inventario generados
  movimientosInventario InventoryMovement[] @relation("RecepcionMovimientos")
  
  // Auditoría
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete
  
  @@index([ordenCompraId])
  @@index([fechaRecepcion])
  @@map("purchase_receipts")
}

// Items de Recepción de Compra
model PurchaseReceiptItem {
  id String @id @default(cuid())
  
  // Relación con recepción
  recepcionId String
  recepcion   PurchaseReceipt @relation(fields: [recepcionId], references: [id], onDelete: Cascade)
  
  // Relación con item de orden de compra
  ordenCompraItemId String
  ordenCompraItem   PurchaseOrderItem @relation(fields: [ordenCompraItemId], references: [id], onDelete: Restrict)
  
  // Relación con producto
  productoId String
  producto   Product @relation("RecepcionProducto", fields: [productoId], references: [id], onDelete: Restrict)
  
  // Cantidades
  cantidadOrdenada  Int // Referencia de OC
  cantidadRecibida  Int // Cantidad física recibida
  cantidadAceptada  Int // Cantidad que pasó QC
  cantidadRechazada Int // Cantidad que falló QC
  
  // Control de calidad
  estadoQC      QualityControlStatus @default(PENDIENTE)
  motivoRechazo String? // Si cantidadRechazada > 0
  
  // Lote y vencimiento (opcional)
  numeroLote       String?
  fechaVencimiento DateTime?
  
  observaciones String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([recepcionId])
  @@index([productoId])
  @@map("purchase_receipt_items")
}

// Factura de Compra (Purchase Invoice)
model PurchaseInvoice {
  id     String @id @default(cuid())
  codigo String @unique // FC-2025-0001
  
  // Relación con orden de compra
  ordenCompraId String        @unique
  ordenCompra   PurchaseOrder @relation(fields: [ordenCompraId], references: [id], onDelete: Restrict)
  
  // Relación con proveedor
  proveedorId String
  proveedor   Client @relation("FacturaProveedor", fields: [proveedorId], references: [id], onDelete: Restrict)
  
  // Usuario que registró la factura
  registradoPorId String
  registradoPor   User   @relation("FacturaRegistradaPor", fields: [registradoPorId], references: [id], onDelete: Restrict)
  
  // Datos del comprobante
  tipoComprobante String // "FACTURA", "BOLETA", "NOTA_CREDITO"
  serie           String // F001
  numero          String // 00000123
  numeroCompleto  String @unique // F001-00000123
  
  // Fechas
  fechaEmision    DateTime
  fechaVencimiento DateTime? // Si es a crédito
  fechaRecepcion  DateTime  @default(now()) // Cuándo se recibió la factura
  
  // Montos
  moneda     String  @default("PEN")
  tipoCambio Decimal @default(1.00) @db.Decimal(10, 4)
  
  subtotal  Decimal @db.Decimal(10, 2)
  descuento Decimal @default(0) @db.Decimal(10, 2)
  igv       Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)
  
  // Validación
  validada            Boolean @default(false)
  diferenciaDetectada Boolean @default(false)
  motivoDiferencia    String? // Si total factura ≠ total OC
  
  // Archivo
  archivoURL String? // PDF escaneado
  
  observaciones String?
  
  // Cuenta por pagar generada
  cuentaPorPagar AccountPayable?
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete
  
  @@unique([serie, numero])
  @@index([proveedorId])
  @@index([fechaEmision])
  @@map("purchase_invoices")
}

// Cuenta por Pagar (Account Payable)
model AccountPayable {
  id     String               @id @default(cuid())
  codigo String               @unique // CXP-2025-0001
  estado AccountPayableStatus @default(PENDIENTE)
  
  // Relación con factura de compra
  facturaCompraId String          @unique
  facturaCompra   PurchaseInvoice @relation(fields: [facturaCompraId], references: [id], onDelete: Restrict)
  
  // Relación con proveedor
  proveedorId String
  proveedor   Client @relation("CuentaPorPagarProveedor", fields: [proveedorId], references: [id], onDelete: Restrict)
  
  // Fechas
  fechaEmision     DateTime
  fechaVencimiento DateTime
  fechaPago        DateTime? // Cuándo se pagó
  
  // Montos
  moneda         String  @default("PEN")
  montoPendiente Decimal @db.Decimal(10, 2)
  montoPagado    Decimal @default(0) @db.Decimal(10, 2)
  montoTotal     Decimal @db.Decimal(10, 2)
  
  // Pago
  metodoPago     String? // "Efectivo", "Transferencia"
  referenciaPago String? // Nro. de operación
  bancoId        String? // Si es transferencia
  
  observaciones String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([proveedorId])
  @@index([estado])
  @@index([fechaVencimiento])
  @@map("accounts_payable")
}

